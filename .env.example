DATABASE_URL=postgres://postgres:postgres@localhost:5432/studio
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# 算算力 OpenAPI（Admin API，仅服务端；Cookie + token 头 + RSA 签名）
SUANLI_OPENAPI_BASE_URL=https://openapi.suanli.cn
SUANLI_OPENAPI_COOKIE=
SUANLI_OPENAPI_TOKEN=
SUANLI_OPENAPI_RSA_PRIVATE_KEY=
# SUANLI_OPENAPI_RSA_PUBLIC_KEY=

# 算算力 Supply OpenAPI（供应商入驻同步，凭证独立）
SUANLI_SUPPLY_OPENAPI_BASE_URL=https://openapi.suanli.cn
SUANLI_SUPPLY_OPENAPI_COOKIE=
SUANLI_SUPPLY_OPENAPI_TOKEN=
SUANLI_SUPPLY_OPENAPI_RSA_PRIVATE_KEY=
# SUANLI_SUPPLY_OPENAPI_RSA_PUBLIC_KEY=

# 本地文件存储根目录（各模块在其下使用独立子目录，如 finance-imports、project-activity-attachments）
DATA_DIR=.data

# 项目活动时间线附件存储（local=本地目录，oss=阿里云 OSS）
PROJECT_ACTIVITY_STORAGE_DRIVER=local
# OSS 模式需配置以下变量
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=
# OSS_PUBLIC_BASE_URL=

# 员工登录账号（管理员创建员工时的默认密码，须符合密码复杂度策略）
STAFF_DEFAULT_PASSWORD=ChangeMe123!
# 历史用户 provisioned_by 回填时使用的管理员 users.id（见设计文档 §9.2）
# BOOTSTRAP_ADMIN_USER_ID=

# 飞书集成（供应域 Phase 1，见 apps/web/content/design/feishu-integration-design.md）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_WEBHOOK_SECRET=
# FEISHU_AUTOMATION_SECRET=
# FEISHU_AUTOMATION_TOKEN=
# FEISHU_DEFAULT_USER_OPEN_ID=
# FEISHU_APPROVAL_FORM_FIELD_ID=
# FEISHU_APPROVAL_CODES={"online":"xxx","order_access":"xxx","device_retire":"xxx","internal_occupancy":"xxx"}
# FEISHU_AUTO_CREATE_ENABLED=true
# FEISHU_AUTO_COMPLETE_ON_APPROVAL=true
# APP_BASE_URL=http://localhost:3000
